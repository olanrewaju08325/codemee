# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/codeme_db

# Supabase Configuration
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Web Push (VAPID) — generate a keypair with:
#   python scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY is the URL-safe base64 (no padding) uncompressed P-256 public point.
# VAPID_PRIVATE_KEY is the URL-safe base64 (no padding) PKCS#8 DER private key.
# VAPID_SUBJECT must be a mailto: link or https:// URL (used in the VAPID JWT 'sub' claim).
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@codemeacademy.com

# Secret for internal cron endpoints — set a long random value and pass it as
# the X-Cron-Secret header when calling POST /api/cron/live-class-reminders.
CRON_SECRET=change-me-to-a-long-random-string

# Environment
ENVIRONMENT=development
